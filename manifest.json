{
  "manifest_version": 3,
  "name": "Santa Pop-In",
  "description": "A tiny Santa who pops in now and then: peeks, strolls, sleigh rides, candy canes, and a snow cloud you can click.",
  "version": "1.1.0",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Santa Pop-In"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/santa-walk.webp",
        "images/peek-santa.webp",
        "images/sleigh.webp"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
