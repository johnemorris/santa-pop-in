{
  "manifest_version": 3,
  "name": "Santa Pop-In",
  "description": "A tiny Santa who pops in with holiday surprises, a Christmas countdown sign, snow clouds, candy canes, lights, and snowy pines.",
  "version": "1.5.0",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Santa Pop-In"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "settings.js",
        "content/core.js",
        "content/stage.js",
        "content/effects.js",
        "content/acts.js",
        "content/snow.js",
        "content/ledges.js",
        "content/decor.js",
        "content/main.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/santa-walk.webp",
        "images/peek-santa.webp",
        "images/sleigh.webp",
        "images/santa-blower.webp",
        "images/sleigh-lounge.webp",
        "images/sleigh-handstand.webp",
        "images/sleigh-swap.webp",
        "images/santa-leg.webp",
        "images/sleigh-elf.webp",
        "images/elf-boy-top.webp",
        "images/elf-boy-leg-b.webp",
        "images/elf-boy-leg-f.webp",
        "images/elf-girl-top.webp",
        "images/elf-girl-leg-b.webp",
        "images/elf-girl-leg-f.webp",
        "images/pine.webp",
        "sounds/cane-pop.ogg",
        "sounds/cloud.ogg",
        "sounds/dance.ogg",
        "sounds/sign.ogg",
        "sounds/sleigh-bells.ogg",
        "sounds/walk-bells.ogg",
        "sounds/blower.ogg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "homepage_url": "https://jem6.com/extensions/santa-pop-in",
  "author": "jem6"
}
